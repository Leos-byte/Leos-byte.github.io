---
import Layout from '~/layouts/PageLayout.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '服务边界｜LeoOne 制造业 AI 试点咨询',
  ignoreTitleTemplate: true,
  description: '了解 LeoOne 制造业 AI 试点咨询的服务范围、信息限制、责任划分与公开材料说明。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl">
      <p class="font-semibold text-primary dark:text-blue-500">服务边界</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        提供决策材料；实施和经营结果由客户负责
      </h1>
      <p class="mt-5 text-xl text-muted dark:text-slate-300">
        LeoOne 的公开服务聚焦制造业 AI
        工作流诊断、试点准备与共创。我们会写清问题、输入、交付物、假设和未决项；客户负责业务决策、采购、实施、访问授权和生产运营。
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">服务不包含</h2>
        <ul class="mt-6 space-y-4">
          {
            [
              '生产软件开发、系统部署、MES/ERP/PLC 集成、模型训练或长期运维。',
              '实时安全监控、事件响应、漏洞扫描、渗透测试或攻击复现。',
              '安全审计、合规认证、法律意见、跨境数据结论或财务判断。',
              '客户采购、上线审批、生产控制、人员决策或经营责任。',
              'ROI、降本、提效、良率、交期、上线时间或转型完成保证。',
            ].map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="flex-none mt-2 h-2 w-2 rounded-full bg-primary dark:bg-blue-500" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">信息边界</h2>
        <ul class="mt-6 space-y-4">
          {
            [
              '在书面确认允许的信息范围前，只使用公开、合成或客户已脱敏并授权的材料。',
              '不接收密码、访问密钥、生产凭据、完整生产日志或不必要的个人与敏感数据。',
              '如请求转向受限数据、生产系统操作、安全测试或高影响自动化，相关工作暂停并重新评估。',
              '网站目前不接收项目申请或信息提交。',
            ].map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="flex-none mt-2 h-2 w-2 rounded-full bg-primary dark:bg-blue-500" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="mt-8 rounded-xl bg-gray-50 dark:bg-slate-800 p-6 md:p-8 max-w-5xl">
      <h2 class="text-2xl font-bold font-heading">公开材料说明</h2>
      <p class="mt-4 text-muted dark:text-slate-300">
        公开文章展示我们的研究和写作方法，不是客户案例或服务成果。Agent Command Center
        公开仓库展示一个工程原型存在，不代表已服务客户、已有制造业部署、实现商业结果，或提供可购买产品和生产服务。
      </p>
    </section>

    <div class="mt-10 flex flex-wrap gap-5">
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/services')}
        >查看三项服务 →</a
      >
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/contact')}
        >查看联系状态 →</a
      >
    </div>
  </section>
</Layout>
