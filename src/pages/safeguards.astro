---
import Layout from '~/layouts/PageLayout.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '服务边界｜LeoOne',
  ignoreTitleTemplate: true,
  description: 'LeoOne 公开说明 AI 转型咨询方向；本站不接收项目申请、联系方式、项目资料或敏感信息。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl">
      <p class="font-semibold text-primary dark:text-blue-500">服务边界</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        公开信息帮助理解方向，不构成项目承诺
      </h1>
      <p class="mt-5 text-xl text-muted dark:text-slate-300">
        LeoOne 公开说明面向个人和企业的 AI
        转型咨询方向，行业不设限。具体项目的范围、责任、可用信息和交付安排，均须书面确认。
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">我们不作的承诺</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          本站不公布可购买服务、价格、周期、容量、结果、ROI、安全、合规或可用性承诺；不将公开材料、场景档案或文章视为客户案例、项目成果或服务开放证明。
        </p>
      </section>
      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">信息边界</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          LeoOne 当前不通过网站接收项目申请、联系方式、项目资料、密码、访问密钥、生产数据、客户机密或其他敏感信息。
        </p>
      </section>
    </div>

    <section class="mt-6 rounded-xl bg-gray-50 dark:bg-slate-800 p-6 md:p-8 max-w-5xl">
      <h2 class="text-2xl font-bold font-heading">场景材料说明</h2>
      <p class="mt-4 text-muted dark:text-slate-300">
        制造业材料是既有公开场景示例，不代表 LeoOne
        只服务、优先服务或已向制造业开放服务。任何行业的具体问题都不能仅据本网站推定服务可用。
      </p>
    </section>

    <div class="mt-10">
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/contact')}>
        查看联系状态 →
      </a>
    </div>
  </section>
</Layout>
