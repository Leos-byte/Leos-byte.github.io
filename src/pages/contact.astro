---
import Layout from '~/layouts/PageLayout.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '联系状态｜LeoOne',
  ignoreTitleTemplate: true,
  description: 'LeoOne 当前不通过网站接收项目申请、联系方式、项目资料或敏感信息。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl">
      <p class="font-semibold text-primary dark:text-blue-500">联系状态</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        本站目前不接收项目申请或资料
      </h1>
      <p class="mt-5 text-xl text-muted dark:text-slate-300">
        LeoOne
        当前不通过本网站接收项目申请、联系方式、项目资料或敏感信息。请勿发送密码、访问密钥、生产数据、客户机密、个人敏感信息或紧急事件信息。
      </p>
    </div>

    <nav class="mt-10 flex flex-wrap gap-5" aria-label="相关说明">
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/services')}>
        了解 AI 转型咨询 →
      </a>
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/safeguards')}>
        查看服务边界 →
      </a>
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getBlogPermalink()}>
        阅读公开文章 →
      </a>
    </nav>
  </section>
</Layout>
