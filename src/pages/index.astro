---
import Layout from '~/layouts/PageLayout.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'LeoOne｜面向个人和企业的 AI 转型咨询',
  ignoreTitleTemplate: true,
  description:
    'LeoOne 是一家 AI 驱动的咨询公司，面向个人和企业，帮助判断 AI 应用在哪里、如何开始，以及试点前需要准备什么。',
};

const focusAreas = [
  '应把 AI 用在什么问题上',
  '第一步从哪里开始',
  '需要补齐哪些能力和治理准备',
  '如何组织试点与后续变化',
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 pt-12 pb-10 md:pt-16 md:pb-12 text-center">
    <p class="font-semibold text-primary dark:text-blue-500">AI 驱动的咨询公司</p>
    <h1 class="mt-3 mx-auto max-w-5xl text-4xl md:text-6xl font-bold leading-tight tracking-tighter font-heading">
      为个人和企业梳理 AI 转型的下一步。
    </h1>
    <p class="mt-5 mx-auto max-w-4xl text-lg md:text-xl text-muted dark:text-slate-300">
      LeoOne 是一家 AI 驱动的咨询公司，为个人和企业提供 AI 转型咨询服务。我们结合
      AI、自动化和专业判断，支持研究、分析、方案设计与交付；AI
      驱动是我们的工作方式，不以自动化替代专业判断，也不承诺特定结果。
    </p>
    <a
      class="inline-flex mt-6 rounded-md bg-primary px-6 py-3 font-semibold text-white hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      href={getPermalink('/services')}
    >
      了解 AI 转型咨询 <span aria-hidden="true" class="ml-2">→</span>
    </a>
  </section>

  <section class="border-y border-gray-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">先把要判断的问题说清楚</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <article class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
          <h3 class="text-2xl font-bold font-heading">面向个人</h3>
          <p class="mt-3 text-muted dark:text-slate-300">
            当你在职业、学习、创作或日常工作中考虑使用 AI，先把“我该如何使用 AI”梳理成目标、现状和需要进一步判断的事项。
          </p>
        </article>
        <article class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
          <h3 class="text-2xl font-bold font-heading">面向企业</h3>
          <p class="mt-3 text-muted dark:text-slate-300">
            当团队准备推进
            AI，先判断应用应从哪里开始，并明确试点前需要准备的能力、责任和治理安排。具体项目范围以书面确认为准。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
    <div class="max-w-4xl">
      <p class="font-semibold text-primary dark:text-blue-500">当前企业重点</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight font-heading">从制造业的真实流程开始</h2>
      <p class="mt-4 text-lg text-muted dark:text-slate-300">
        制造业 AI 工作流诊断与试点准备，是 LeoOne 当前已公开的企业重点入口。现有材料帮助制造团队围绕真实流程，明确首个
        AI 试点的优先级、范围和必要控制点。
      </p>
      <a
        class="inline-block mt-5 font-semibold text-primary hover:underline dark:text-blue-500"
        href={getPermalink('/services#manufacturing')}
      >
        查看制造业重点 →
      </a>
    </div>
  </section>

  <section class="border-y border-gray-200 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-900/30">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">AI 转型咨询关注什么</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          focusAreas.map((item) => (
            <li class="flex gap-3 rounded-lg bg-white dark:bg-slate-800 p-5">
              <span aria-hidden="true" class="flex-none mt-2 h-2 w-2 rounded-full bg-primary dark:bg-blue-500" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-muted dark:text-slate-300">实际工作范围、可用信息和责任，在项目开始前书面确认。</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">公开文章</h2>
    <p class="mt-3 max-w-3xl text-muted dark:text-slate-300">
      LeoOne 已公开发布中文文章，说明我们如何区分事实、假设和下一步判断。文章不是客户案例，也不代表服务成果。
    </p>
    <a
      class="inline-block mt-5 font-semibold text-primary hover:underline dark:text-blue-500"
      href={getBlogPermalink()}
    >
      阅读公开文章 →
    </a>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-900/30">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">服务边界</h2>
      <p class="mt-3 max-w-3xl text-muted dark:text-slate-300">
        本站当前用于说明公开信息，不接收项目申请、联系方式、项目资料或敏感信息。
      </p>
      <a
        class="inline-block mt-5 font-semibold text-primary hover:underline dark:text-blue-500"
        href={getPermalink('/safeguards')}
      >
        查看服务边界 →
      </a>
    </div>
  </section>
</Layout>
