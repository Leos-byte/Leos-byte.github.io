---
import Header from '~/components/StudioHeader.astro';
import Footer from '~/components/StudioFooter.astro';
const projects = [
  {
    name: 'Agent Privacy Layer',
    type: 'PRIVACY / DEVELOPER TOOLS',
    status: 'Concept',
    desc: '探索本地优先的 AI Agent 隐私保护基础设施。',
    visual: 'privacy',
  },
  {
    name: 'Prompt Coordinate',
    type: 'DESIGN / KNOWLEDGE',
    status: 'Concept',
    desc: '为创作者建立设计、写作与 AI 协作规范的坐标系。',
    visual: 'coordinate',
  },
];
const principles = [
  { symbol: '◇', name: 'Independent', text: '独立思考，不盲从潮流。' },
  { symbol: '⌘', name: 'Build for Real', text: '为真实问题创造有用的工具。' },
  { symbol: '∞', name: 'Long-term', text: '关注长期价值，持续改进。' },
  { symbol: '✳', name: 'Open & Share', text: '开放协作，分享探索与成果。' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href="https://leoone.uk/" />
    <meta
      name="description"
      content="LEOONE — Independent thinking. Meaningful building. 探索人工智能、隐私技术与开放创新。"
    />
    <meta property="og:title" content="LEOONE — Think freely. Build boldly." />
    <meta property="og:description" content="Independent thinking. Meaningful building." />
    <meta property="og:type" content="website" />
    <title>LEOONE — Think freely. Build boldly.</title>
    <style>
      :root {
        font-family:
          Inter,
          ui-sans-serif,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          'Noto Sans SC',
          sans-serif;
        color: #151515;
        background: #f8f7f4;
        font-synthesis: none;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        font: inherit;
      }
      ::selection {
        background: #475cff;
        color: white;
      }
      .wrap {
        width: min(1180px, calc(100% - 64px));
        margin: auto;
      }
      .top {
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e6e4e0;
      }
      .brand {
        font-weight: 900;
        letter-spacing: -0.08em;
        font-size: 26px;
      }
      .brand span {
        color: #4355ff;
        margin-right: 9px;
      }
      .nav {
        display: flex;
        gap: 40px;
        font-size: 13px;
        font-weight: 600;
      }
      .nav a:hover,
      .more:hover {
        color: #4355ff;
      }
      .topright {
        font-size: 12px;
      }
      .eyebrow {
        font-size: 11px;
        letter-spacing: 0.24em;
        font-weight: 700;
        color: #666;
      }
      .hero {
        min-height: 590px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        position: relative;
      }
      .hero h1 {
        font-size: clamp(58px, 6.5vw, 98px);
        line-height: 0.98;
        letter-spacing: -0.085em;
        margin: 34px 0 25px;
        font-weight: 850;
      }
      .blue {
        color: #4355ff;
      }
      .lead {
        font-size: 18px;
        line-height: 1.6;
        color: #565656;
        max-width: 500px;
      }
      .actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        padding: 15px 23px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid #151515;
        transition:
          transform 0.2s,
          background 0.2s;
      }
      .btn:hover {
        transform: translateY(-3px);
      }
      .btn.primary {
        background: #151515;
        color: white;
      }
      .btn.secondary {
        background: transparent;
      }
      .art {
        height: 450px;
        display: grid;
        place-items: center;
        position: relative;
        overflow: hidden;
      }
      .ring {
        width: 320px;
        height: 320px;
        border: 64px solid transparent;
        border-top-color: #c4c6cb;
        border-left-color: #777c88;
        border-right-color: #e1e3e7;
        border-bottom-color: #a0a5ae;
        border-radius: 50%;
        transform: rotate(-32deg) skew(13deg, 13deg);
        box-shadow:
          30px 40px 65px #0002,
          inset 15px 15px 35px #fff9;
        filter: drop-shadow(0 20px 20px #0001);
      }
      .art:after {
        content: '';
        position: absolute;
        width: 390px;
        height: 390px;
        border: 1px solid #c5c5c5;
        border-radius: 50%;
        transform: rotate(40deg) scaleY(0.4);
        pointer-events: none;
      }
      .section {
        padding: 70px 0;
      }
      .sectionhead {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin-bottom: 28px;
      }
      .section h2 {
        font-size: clamp(34px, 4vw, 50px);
        letter-spacing: -0.06em;
        line-height: 1.06;
        margin: 12px 0 0;
      }
      .more {
        font-size: 13px;
        font-weight: 700;
      }
      .projects {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }
      .project {
        border-radius: 12px;
        min-height: 300px;
        padding: 34px;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .project.dark {
        background: #191b20;
        color: white;
      }
      .project.light {
        background: #ebebed;
        color: #171717;
      }
      .project .meta {
        font-size: 10px;
        letter-spacing: 0.14em;
        opacity: 0.7;
      }
      .project h3 {
        font-size: 28px;
        letter-spacing: -0.04em;
        margin: 12px 0;
      }
      .project p {
        max-width: 300px;
        font-size: 14px;
        line-height: 1.7;
        opacity: 0.7;
      }
      .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 99px;
        background: #a6b5ff;
        color: #111;
        font-size: 10px;
        margin-left: 10px;
        vertical-align: middle;
        letter-spacing: 0;
      }
      .project .shape {
        position: absolute;
        right: -65px;
        top: 60px;
        width: 235px;
        height: 235px;
        border: 1px solid #ffffff66;
        border-radius: 30px;
        transform: rotate(-30deg);
        box-shadow:
          -22px 20px 0 #7084ff22,
          -44px 40px 0 #7084ff22;
        pointer-events: none;
      }
      .project.light .shape {
        border-color: #849bff;
        box-shadow:
          -22px 20px 0 #a6b5ff66,
          -44px 40px 0 #a6b5ff44;
      }
      .project .bottom {
        font-size: 13px;
        font-weight: 700;
        z-index: 1;
      }
      .principles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin-top: 40px;
      }
      .principle {
        padding: 18px 24px;
        border-right: 1px solid #deddd9;
      }
      .principle:first-child {
        padding-left: 0;
      }
      .principle:last-child {
        border: 0;
      }
      .symbol {
        font-size: 35px;
      }
      .principle h3 {
        font-size: 19px;
        letter-spacing: -0.03em;
      }
      .principle p {
        font-size: 13px;
        color: #666;
        line-height: 1.7;
      }
      .journal {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .story {
        border-top: 1px solid #d5d4d0;
        padding-top: 20px;
      }
      .story .category {
        font-size: 10px;
        letter-spacing: 0.18em;
        color: #4355ff;
        font-weight: 800;
      }
      .story h3 {
        font-size: 21px;
        line-height: 1.3;
        letter-spacing: -0.035em;
      }
      .story p {
        color: #6a6a6a;
        font-size: 13px;
        line-height: 1.7;
      }
      .story a {
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .about {
        background: #18191d;
        color: white;
        border-radius: 14px;
        padding: 54px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
      }
      .about h2 {
        font-size: clamp(38px, 4.6vw, 64px);
        letter-spacing: -0.065em;
        line-height: 1.05;
        margin: 14px 0;
      }
      .about p {
        color: #bcbcc2;
        line-height: 1.9;
        font-size: 15px;
      }
      .about .quote {
        border-left: 1px solid #5960a7;
        padding-left: 35px;
        align-self: center;
        font-size: 25px;
        line-height: 1.5;
        color: #e9e9ed;
      }
      .footer {
        border-top: 1px solid #deddd9;
        margin-top: 80px;
        padding: 30px 0 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #666;
      }
      .footer strong {
        font-size: 19px;
        color: #151515;
        letter-spacing: -0.07em;
      }
      .footerlinks {
        display: flex;
        gap: 25px;
      }
      @media (max-width: 800px) {
        .wrap {
          width: min(100% - 36px, 1180px);
        }
        .top {
          height: 68px;
        }
        .nav {
          gap: 15px;
          font-size: 11px;
        }
        .topright {
          display: none;
        }
        .hero {
          grid-template-columns: 1fr;
          min-height: auto;
          padding: 85px 0 30px;
        }
        .hero h1 {
          font-size: clamp(54px, 11vw, 80px);
        }
        .art {
          height: 260px;
          grid-row: 2;
        }
        .ring {
          width: 190px;
          height: 190px;
          border-width: 38px;
        }
        .art:after {
          width: 260px;
          height: 260px;
        }
        .section {
          padding: 45px 0;
        }
        .projects,
        .about {
          grid-template-columns: 1fr;
        }
        .principles {
          grid-template-columns: repeat(2, 1fr);
        }
        .principle:nth-child(2) {
          border-right: 0;
        }
        .principle:nth-child(3) {
          padding-left: 0;
        }
        .journal {
          grid-template-columns: 1fr;
        }
        .about {
          padding: 32px;
          gap: 20px;
        }
        .about .quote {
          font-size: 20px;
        }
        .footer {
          flex-wrap: wrap;
          gap: 20px;
        }
      }
      @media (max-width: 440px) {
        .nav {
          gap: 10px;
        }
        .brand {
          font-size: 22px;
        }
        .sectionhead {
          align-items: start;
          gap: 12px;
        }
        .more {
          white-space: nowrap;
        }
        .project {
          padding: 25px;
        }
        .actions {
          flex-wrap: wrap;
        }
        .principle {
          padding: 14px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *:before,
        *:after {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="wrap hero">
        <div>
          <div class="eyebrow">INDEPENDENT VENTURE STUDIO</div><h1>
            Think freely.<br /><span class="blue">Build boldly.</span>
          </h1><p class="lead">
            Ideas, experiments and products at the intersection of technology and humanity.<br
            />独立思考，创造有意义的产品。
          </p><div class="actions">
            <a class="btn primary" href="/work/">Explore Work ↗</a><a class="btn secondary" href="/journal/"
              >Read Journal →</a
            >
          </div>
        </div><div class="art" aria-hidden="true"><div class="ring"></div></div>
      </section>
      <section class="wrap section" id="work">
        <div class="sectionhead">
          <div><div class="eyebrow">FEATURED WORK</div><h2>Products & Projects</h2></div><a
            class="more"
            href="https://github.com/Leos-byte"
            target="_blank"
            rel="noopener noreferrer">Explore GitHub ↗</a
          >
        </div><div class="projects">
          {
            projects.map((project) => (
              <article class:list={['project', project.visual === 'privacy' ? 'dark' : 'light']}>
                <>
                  <div>
                    <>
                      <div class="meta">{project.type}</div>
                      <h3>
                        {project.name}
                        <span class="status">{project.status}</span>
                      </h3>
                      <p>{project.desc}</p>
                    </>
                  </div>
                  <div class="shape" aria-hidden="true" />
                  <a
                    class="bottom"
                    href={project.visual === 'privacy' ? '/work/agent-privacy-layer/' : '/work/prompt-coordinate/'}
                  >
                    了解项目构想 →
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </section>
      <section class="wrap section">
        <div class="eyebrow">WHAT I BELIEVE</div><h2>Principles in Action</h2><div class="principles">
          {
            principles.map((p) => (
              <div class="principle">
                <>
                  <div class="symbol" aria-hidden="true">
                    {p.symbol}
                  </div>
                  <h3>{p.name}</h3>
                  <p>{p.text}</p>
                </>
              </div>
            ))
          }
        </div>
      </section>
      <section class="wrap section" id="journal">
        <div class="sectionhead">
          <div><div class="eyebrow">THOUGHTS & RESEARCH</div><h2>Journal</h2></div><a class="more" href="/journal/"
            >Read articles ↗</a
          >
        </div><div class="journal">
          <article class="story">
            <div class="category">AI & AGENTS</div><h3>智能体与软件的未来</h3><p>
              关于 AI Agent、工作流、协作系统与工具构建的探索。
            </p><a href="/journal/">Explore writing ↗</a>
          </article><article class="story">
            <div class="category">PRIVACY & SECURITY</div><h3>隐私作为基础设施</h3><p>
              关注隐私保护、网络安全与值得信赖的技术系统。
            </p><a href="/journal/">Explore writing ↗</a>
          </article><article class="story">
            <div class="category">IDEAS & SOCIETY</div><h3>技术与人的关系</h3><p>
              记录独立思考、创造实践与技术的社会影响。
            </p><a href="/journal/">Explore writing ↗</a>
          </article>
        </div>
      </section>
      <section class="wrap section" id="about">
        <div class="about">
          <div>
            <div class="eyebrow">ABOUT LEOONE</div><h2>Technology should amplify humanity.</h2><p>
              LEOONE
              是一个独立的创作与实验空间。关注人工智能、开放技术与数字自由，通过研究、写作和产品实验，将有意义的想法转化为实践。
            </p>
          </div><div class="quote">“Build what matters.<br />Share what you learn.<br />Stay independent.”</div>
        </div>
      </section>
      <section class="wrap section" id="now">
        <div class="eyebrow">CURRENTLY EXPLORING</div><h2>What's Next</h2><p class="lead">
          正在探索 AI Agent、隐私优先的开发工具，以及让知识与创造更容易被分享的产品。
        </p><a class="btn secondary" href="https://github.com/Leos-byte" target="_blank" rel="noopener noreferrer"
          >Follow on GitHub ↗</a
        >
      </section>
    </main><Footer />
  </body>
</html>
