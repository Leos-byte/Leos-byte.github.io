---
import Layout from '~/layouts/PageLayout.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'LeoOne｜制造业 AI 工作流诊断与试点路线图',
  ignoreTitleTemplate: true,
  description:
    'LeoOne 帮助处于探索或早期试点阶段的中国制造企业，从一个具体流程形成 AI 机会优先级、试点范围与准备路线图。',
};

const services = [
  {
    label: '主服务 · 先诊断',
    title: '制造业 AI 工作流诊断与试点路线图',
    description: '还没确定先做什么：比较候选流程，选定首个试点。',
    output: '优先级、试点范围、准备清单与行动路线图',
    href: getPermalink('/services#workflow-roadmap'),
  },
  {
    label: '支持服务 · 做准备',
    title: 'AI 试点准备与治理设计',
    description: '已有试点方向：对齐责任、数据边界、人工复核与评估方式。',
    output: '试点章程、责任分工、控制点与评估模板',
    href: getPermalink('/services#pilot-readiness'),
  },
  {
    label: '支持服务 · 促共创',
    title: '制造团队 AI 工作流共创工作坊',
    description: '需要跨部门共识：围绕一个真实流程比较场景并明确下一步。',
    output: '问题陈述、场景排序、风险依赖与行动清单',
    href: getPermalink('/services#workshop'),
  },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 pt-12 pb-10 md:pt-16 md:pb-12 text-center">
    <p class="font-semibold text-primary dark:text-blue-500">面向中国制造企业的运营与数字化负责人</p>
    <h1 class="mt-3 mx-auto max-w-5xl text-4xl md:text-6xl font-bold leading-tight tracking-tighter font-heading">
      先找对一个工作流，再启动 AI 试点。
    </h1>
    <p class="mt-5 mx-auto max-w-3xl text-lg md:text-xl text-muted dark:text-slate-300">
      LeoOne 帮你明确第一个值得验证的制造流程、所需条件和下一步决策，形成一份可供内部审阅的试点路线图。
    </p>
    <a
      class="inline-flex mt-7 rounded-md bg-primary px-6 py-3 font-semibold text-white hover:bg-secondary"
      href={getPermalink('/services')}
    >
      查看服务与交付物 <span aria-hidden="true" class="ml-2">→</span>
    </a>
  </section>

  <section class="border-y border-gray-200 dark:border-slate-800" id="services">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="sr-only">三项服务比较</h2>
      <div class="grid gap-4 lg:grid-cols-3">
        {
          services.map(({ label, title, description, output, href }) => (
            <article class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 md:p-6 flex flex-col">
              <p class="text-sm font-semibold text-primary dark:text-blue-500">{label}</p>
              <h3 class="mt-2 text-xl font-bold font-heading">{title}</h3>
              <p class="mt-3 text-muted dark:text-slate-300">{description}</p>
              <p class="mt-4 pt-4 border-t border-gray-200 dark:border-slate-700 text-sm flex-grow">
                <strong>得到：</strong>
                {output}
              </p>
              <a class="mt-4 font-semibold text-primary hover:underline dark:text-blue-500" href={href}>
                查看详情 <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12" id="how-it-works">
    <div class="max-w-3xl">
      <p class="font-semibold text-primary dark:text-blue-500">工作方式</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight font-heading">从不确定走向试点准备</h2>
      <p class="mt-3 text-muted dark:text-slate-300">三项服务可分别选择，并非必须依次购买。</p>
    </div>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {
        [
          ['01', '诊断', '看清流程现状，比较机会、前提与风险。'],
          ['02', '准备', '写清范围、责任、数据边界、控制点与评估方式。'],
          ['03', '共创', '让业务、运营与 IT 对候选场景及下一步达成共识。'],
        ].map(([number, title, description]) => (
          <li class="rounded-lg bg-gray-50 dark:bg-slate-800 p-6">
            <span class="text-sm font-bold text-primary dark:text-blue-500">{number}</span>
            <h3 class="mt-1 text-2xl font-bold font-heading">{title}</h3>
            <p class="mt-2 text-muted dark:text-slate-300">{description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12" id="proof">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="max-w-3xl text-muted dark:text-slate-300">
        LeoOne 已公开发布带来源的中文洞见，展示我们如何区分事实、假设与下一步判断。
      </p>
      <a class="flex-none font-semibold text-primary hover:underline dark:text-blue-500" href={getBlogPermalink()}>
        阅读公开洞见 →
      </a>
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-900/30">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-8 text-sm text-muted dark:text-slate-300">
      服务范围、输入和交付物须在开始前书面确认；LeoOne 提供决策与试点准备材料，客户负责业务决策、实施和生产运营。
      <a class="ml-1 font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/safeguards')}
        >查看范围与边界 →</a
      >
    </div>
  </section>
</Layout>
