---
import Layout from '~/layouts/PageLayout.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { findLatestPosts } from '~/utils/blog';

const posts = await findLatestPosts({ count: 3 });
const metadata = {
  title: 'LeoOne｜让 AI 走进真实工作',
  ignoreTitleTemplate: true,
  description: 'LeoOne 面向个人与企业提供 AI 转型咨询。从一项真实任务开始，厘清 AI 的用途、人工判断与下一步标准。',
};
const situations = [
  {
    number: '01',
    title: '从哪里开始？',
    subtitle: '找到值得先做的一件事',
    description: '工具很多，时间有限。从高频、有人负责、确实卡住的工作中，找到一个具体的起点。',
    icon: '↗',
  },
  {
    number: '02',
    title: '怎样一起用？',
    subtitle: '让团队有共同的做法',
    description: '把材料准备、结果核对与异常处理说清，让个人的尝试成为可以讨论、练习和复用的流程。',
    icon: '◎',
  },
  {
    number: '03',
    title: '边界在哪里？',
    subtitle: '保留人的判断与责任',
    description: '明确哪些步骤适合 AI 协助，哪些信息不能输入，哪些输出必须由人查证、签核或决定。',
    icon: '⊞',
  },
];
const questions = [
  ['目标', '要完成什么，当前卡在哪里？'],
  ['输入', '材料来自哪里，哪些信息不能使用？'],
  ['产出', '需要什么结果，谁对它负责？'],
  ['判断', 'AI 参与哪一步，哪里需要人工复核？'],
  ['验证', '如何判断继续、调整，还是停止？'],
];
---

<Layout metadata={metadata}>
  <section class="leo-hero leo-container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> AI 转型咨询 · 面向个人与企业</p>
      <h1 id="hero-title">让 AI 走进<br />真实的<span class="hero-emphasis">工作。</span></h1>
      <p class="hero-description">先把一件具体的事说清，<br />再决定怎么用 AI。</p>
      <p class="hero-detail">从任务、流程与使用边界出发，让 AI 的用途、人的判断，以及下一步的标准，都更清楚。</p>
      <div class="hero-actions">
        <a class="leo-button" href={getPermalink('/services')}>了解咨询方向 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#approach">探索我们的方法 <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note">行业不设限 · 具体项目范围须书面确认</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-top"><span>LEOONE / WORK IN FOCUS</span><span>01 — 05</span></div>
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="art-axis axis-horizontal"></div><div class="art-axis axis-vertical"></div>
      <div class="focus-core"><span>从一件事开始</span><strong>清晰</strong><small>CLARITY FIRST</small></div>
      <div class="orbit-label label-input"><span class="tiny-dot"></span>真实任务</div>
      <div class="orbit-label label-human"><span class="tiny-dot"></span>人工判断</div>
      <div class="orbit-label label-ai"><span class="tiny-dot"></span>AI 协助</div>
      <div class="art-bottom"><span>问题 → 方法 → 下一步</span><span class="art-cross">＋</span></div>
    </div>
  </section>

  <div class="principle-strip">
    <div class="leo-container">
      <span>TECHNOLOGY WITH INTENTION</span><p>从真实问题出发 <i>/</i> 让判断保持可见 <i>/</i> 用观察决定下一步</p>
    </div>
  </div>

  <section class="leo-container leo-section" aria-labelledby="situations-title">
    <div class="section-heading">
      <div><p class="eyebrow">01 / 找到起点</p><h2 id="situations-title">你可能，正卡在这里。</h2></div><p
        class="section-intro"
      >
        不必先谈一套宏大的转型方案。<br />先看眼前的一项工作。
      </p>
    </div>
    <div class="situation-grid">
      {
        situations.map((item) => (
          <article class="situation-card">
            <>
              <div class="card-top">
                <>
                  <span>{item.number}</span>
                  <span class="card-symbol" aria-hidden="true">
                    {item.icon}
                  </span>
                </>
              </div>
              <h3>{item.title}</h3>
              <h4>{item.subtitle}</h4>
              <p>{item.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section id="approach" class="approach-section" aria-labelledby="approach-title">
    <div class="leo-container approach-grid">
      <div class="approach-copy">
        <p class="eyebrow">02 / 我们的方法</p><h2 id="approach-title">一个真实任务。<br />五个关键问题。</h2><p>
          把抽象的「AI 转型」落到输入、产出、检查点与责任人上。先厘清，再尝试；用少量练习或记录，检验做法能否复用。
        </p><a class="text-link" href={getPermalink('/services')}
          >进一步了解咨询方向 <span aria-hidden="true">↗</span></a
        ><div class="method-caption"><span aria-hidden="true">↳</span> 清楚的起点，才有可讨论的下一步。</div>
      </div><ol class="question-list">
        {
          questions.map(([label, question], index) => (
            <li>
              <>
                <span class="question-number">0{index + 1}</span>
                <div>
                  <>
                    <h3>{label}</h3>
                    <p>{question}</p>
                  </>
                </div>
                <span class="question-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="leo-container leo-section" aria-labelledby="research-title">
    <div class="section-heading">
      <div><p class="eyebrow">03 / 公开研究</p><h2 id="research-title">保持好奇，也保持判断。</h2></div><a
        class="text-link"
        href={getBlogPermalink()}>所有文章 <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="research-grid">
      {
        posts.map((post, index) => (
          <a class="research-card" href={getPermalink(post.permalink, 'post')}>
            <>
              <div class:list={['research-art', `research-art-${index}`]} aria-hidden="true">
                <>
                  <span class="research-art-label">LEOONE NOTES / 0{index + 1}</span>
                  <div class="research-glyph">{['↗', '◎', '⌘'][index]}</div>
                  <span class="research-art-caption">{post.category?.title || '研究与观察'}</span>
                </>
              </div>
              <div class="research-body">
                <>
                  <div class="research-meta">
                    <>
                      <time datetime={post.publishDate.toISOString()}>
                        {post.publishDate.toISOString().slice(0, 10).replaceAll('-', '.')}
                      </time>
                      <span>研究笔记</span>
                    </>
                  </div>
                  <h3>{post.title}</h3>
                  <p>{post.excerpt}</p>
                  <span class="research-read">
                    阅读全文 <span aria-hidden="true">↗</span>
                  </span>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
    <p class="section-note">公开研究与写作材料，用于区分事实、假设与待确认问题；不代表客户案例或服务成果。</p>
  </section>

  <section class="leo-container closing-section">
    <div class="closing-panel">
      <div>
        <p class="eyebrow">从理解，到下一步</p><h2>先让问题变清楚。</h2><p>
          了解我们的咨询方向、场景材料，以及工作中的责任与边界。
        </p>
      </div><a class="leo-button light-button" href={getPermalink('/services#scenarios')}
        >查看场景档案 <span aria-hidden="true">↗</span></a
      >
    </div><p class="closing-note">
      本站目前仅说明公开信息，不接收项目申请、联系方式、项目资料或敏感信息。<a href={getPermalink('/safeguards')}
        >查看服务边界 ↗</a
      >
    </p>
  </section>
</Layout>
