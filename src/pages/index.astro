---
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../consts";
import { getPublishedPosts, getTagGroups } from "../lib/posts";
import { withBase } from "../lib/url";

const posts = await getPublishedPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 4);
const tagGroups = await getTagGroups();
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="intro-section">
    <p class="eyebrow">Astro / GitHub Pages / Notes</p>
    <h1>把开发过程写成可复用的记录。</h1>
    <p>
      {SITE_DESCRIPTION}
    </p>
  </section>

  {
    featuredPost && (
      <section class="featured-section" aria-labelledby="featured-title">
        <div class="section-heading">
          <p>Featured</p>
          <h2 id="featured-title">精选文章</h2>
        </div>
        <PostCard post={featuredPost} featured />
      </section>
    )
  }

  <section class="home-grid" aria-label="博客内容">
    <div>
      <div class="section-heading">
        <p>Latest</p>
        <h2>最新文章</h2>
      </div>
      <div class="post-list">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
      <a class="text-link" href={withBase("/blog/")}>查看全部文章</a>
    </div>

    <aside class="home-aside" aria-label="标签">
      <div class="section-heading">
        <p>Topics</p>
        <h2>标签</h2>
      </div>
      <div class="tag-cloud">
        {
          tagGroups.map((tag) => (
            <a href={withBase(`/tags/${tag.slug}/`)}>
              {tag.name}
              <span>{tag.count}</span>
            </a>
          ))
        }
      </div>
    </aside>
  </section>
</BaseLayout>
