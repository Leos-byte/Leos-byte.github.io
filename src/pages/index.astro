---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'LeoOne｜制造业 AI 工作流诊断与试点路线图',
  ignoreTitleTemplate: true,
  description:
    'LeoOne 面向中国制造企业提供固定范围的 AI 工作流诊断、试点准备与共创工作坊，从一个具体流程形成优先级、试点范围和行动路线图。',
};

const serviceCards = [
  {
    eyebrow: '主服务',
    title: '制造业 AI 工作流诊断与试点路线图',
    description: '围绕一个工厂、业务单元或紧密相关的流程组，筛选 AI 适用点，识别前提与风险，形成共同决策依据。',
    deliverable: '流程现状图、机会优先级矩阵、试点范围说明书、准备清单、30 天路线图与管理层决策简报。',
    href: getPermalink('/services#workflow-roadmap'),
  },
  {
    eyebrow: '支持服务',
    title: 'AI 试点准备与治理设计',
    description: '为已经选定方向的试点补齐范围、责任、人工复核、数据边界、评估方式和升级路径。',
    deliverable: '试点章程、RACI 草案、人工在环流程、数据与权限确认清单、评估与复盘模板。',
    href: getPermalink('/services#pilot-readiness'),
  },
  {
    eyebrow: '支持服务',
    title: '制造团队 AI 工作流共创工作坊',
    description: '让业务、运营与 IT 围绕一个真实流程建立共同语言，比较候选场景并明确下一步责任。',
    deliverable: '问题陈述、候选场景卡片、优先级排序、风险与依赖清单、行动清单草案。',
    href: getPermalink('/services#workshop'),
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="面向中国制造企业的 AI 转型咨询"
    title={'先找对一个工作流，<br class="hidden md:inline" />再启动 AI 试点。'}
    subtitle="LeoOne 帮助处于探索或早期试点阶段的制造企业，识别值得优先处理的业务流程，厘清数据、人员与系统边界，并形成可进入内部决策与试点准备的路线图。我们从一个具体流程开始，而不是推销一套万能 AI 平台。"
    callToAction={{
      variant: 'primary',
      text: '查看服务与交付物',
      href: getPermalink('/services'),
      icon: 'tabler:chevron-right',
    }}
  />

  <section class="border-y border-gray-200 dark:border-slate-800" aria-label="当前联系状态">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-5 text-sm md:text-base text-muted dark:text-slate-300">
      公开项目联系渠道尚未获批，本站目前不接收项目申请、敏感信息或紧急支持请求。
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20" id="services">
    <div class="max-w-3xl">
      <p class="font-semibold text-primary dark:text-blue-500">三项有明确边界的咨询服务</p>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight font-heading">把 AI 讨论变成一个可做决定的试点</h2>
      <p class="mt-4 text-lg text-muted dark:text-slate-300">
        主服务用于从流程中选择第一个试点；两项支持服务用于补齐已有试点或建立跨部门共识。实际范围、周期、输入和费用须经书面确认。
      </p>
    </div>
    <div class="mt-8 md:mt-12 grid gap-6 lg:grid-cols-3">
      {
        serviceCards.map(({ eyebrow, title, description, deliverable, href }) => (
          <article class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8 flex flex-col">
            <p class="text-sm font-semibold text-primary dark:text-blue-500">{eyebrow}</p>
            <h3 class="mt-2 text-xl md:text-2xl font-bold font-heading">{title}</h3>
            <p class="mt-4 text-muted dark:text-slate-300">{description}</p>
            <div class="mt-5 pt-5 border-t border-gray-200 dark:border-slate-700 flex-grow">
              <p class="text-sm font-semibold">你将获得</p>
              <p class="mt-2 text-sm text-muted dark:text-slate-400">{deliverable}</p>
            </div>
            <a
              class="inline-flex items-center mt-6 font-semibold text-primary hover:underline dark:text-blue-500"
              href={href}
            >
              查看范围与交付物{' '}
              <span aria-hidden="true" class="ml-1">
                →
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800" id="deliverables">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
      <div class="max-w-3xl">
        <p class="font-semibold text-primary dark:text-blue-500">主服务的工作结果</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight font-heading">
          一次诊断，形成六份可审阅的工作材料
        </h2>
      </div>
      <ol class="mt-8 md:mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            ['01', '流程现状图', '记录角色、输入、判断点、系统接点、等待与返工。'],
            ['02', '机会优先级矩阵', '比较业务价值、可行性、数据条件、变更负担与风险。'],
            ['03', '试点范围说明书', '写明目标、用户、输入输出、人工复核点、成功判据与非目标。'],
            ['04', '数据与治理准备清单', '列出待确认的数据、权限、系统假设、责任人和升级路径。'],
            ['05', '30 天工作流路线图', '拆解负责人、关键决策、验证动作、依赖、风险与复盘节点。'],
            ['06', '管理层决策简报', '支持内部决定推进、补齐条件、调整范围或暂停。'],
          ].map(([number, title, description]) => (
            <li class="rounded-lg bg-gray-50 dark:bg-slate-800 p-6">
              <span class="text-sm font-bold text-primary dark:text-blue-500">{number}</span>
              <h3 class="mt-2 text-xl font-bold font-heading">{title}</h3>
              <p class="mt-2 text-muted dark:text-slate-300">{description}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-sm text-muted dark:text-slate-400 max-w-4xl">
        30 天描述的是在客户及时提供人员、流程材料与决策参与前提下的推荐工作节奏，不是上线、降本、ROI 或转型完成保证。
      </p>
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800" id="proof">
    <div
      class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start"
    >
      <div class="max-w-3xl">
        <p class="font-semibold text-primary dark:text-blue-500">公开证据，而不是客户案例</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight font-heading">可检查的工程探索与研究方法</h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-300">
          LeoOne 公开发布带来源与适用范围说明的中文洞见；团队也维护 Agent Command Center
          公开代码仓库，用于展示对任务状态、来源追溯与决策记录的工程探索。
        </p>
        <div class="mt-6 flex flex-wrap gap-5">
          <a
            class="font-semibold text-primary hover:underline dark:text-blue-500"
            href="https://github.com/forkbombruler/agent-command-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            查看 Agent Command Center 公开仓库 <span aria-hidden="true">↗</span>
          </a>
          <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getBlogPermalink()}>
            阅读公开洞见 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <aside class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h3 class="text-xl font-bold font-heading">证据边界</h3>
        <p class="mt-3 text-muted dark:text-slate-300">
          Agent Command Center
          是公开工程原型，不是可购买的客户产品、生产系统、托管平台、客户成果证明或本服务的交付承诺。公开文章也不构成制造业实施案例或客户背书。
        </p>
      </aside>
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading">我们会明确不做什么</h2>
        <ul class="mt-8 space-y-4 text-lg">
          {
            [
              '不承诺替客户完成全厂 AI 转型、上线生产系统或实现特定 ROI。',
              '不代替软件供应商做开发、MES/ERP 集成、模型训练或长期运维。',
              '不提供安全审计、渗透测试、合规认证、法律意见或跨境数据合规结论。',
              '不接收密码、生产凭据、完整生产日志或不必要的个人与敏感数据。',
            ].map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="flex-none mt-2 h-2 w-2 rounded-full bg-primary dark:bg-blue-500" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a
          class="inline-flex mt-8 font-semibold text-primary hover:underline dark:text-blue-500"
          href={getPermalink('/safeguards')}
        >
          查看完整范围与边界 <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-slate-800 bg-gray-50 dark:bg-slate-900/40">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold font-heading">项目联系渠道尚未开放</h2>
      <p class="mt-4 mx-auto max-w-2xl text-muted dark:text-slate-300">
        在公开联系方式、收件责任人及与实际行为一致的数据处理说明获得批准前，LeoOne
        不通过本站接收项目申请。你仍可查看完整服务范围与公开材料。
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-5">
        <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/services')}
          >查看三项服务 →</a
        >
        <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getBlogPermalink()}
          >阅读公开洞见 →</a
        >
      </div>
    </div>
  </section>
</Layout>
