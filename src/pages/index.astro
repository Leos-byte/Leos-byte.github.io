---
import Layout from '~/layouts/PageLayout.astro';
import { findLatestPosts } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const posts = await findLatestPosts({ count: 3 });
const metadata = {
  title: 'LEO | 网络安全与 AI 安全培训咨询',
  ignoreTitleTemplate: true,
  description: 'LEO Cybersecurity & AI Security：面向企业与专业团队的网络安全培训、AI 安全风险治理与安全应用能力建设。',
};
const services = [
  {
    id: 'security',
    n: '01',
    zh: '网络安全培训',
    en: 'Cybersecurity Training',
    descZh: '面向企业员工、IT 与安全团队的分层培训，围绕安全意识、威胁识别及防护实践建立可执行的能力。',
    descEn: 'Practical cybersecurity learning for employees, IT teams and security practitioners.',
    tags: ['Security Awareness', 'Cyber Defense'],
  },
  {
    id: 'advisory',
    n: '02',
    zh: 'AI 安全与风险治理',
    en: 'AI Security Advisory',
    descZh: '协助梳理企业生成式 AI 应用场景、数据使用边界、风险控制与治理路径。具体范围按项目确认。',
    descEn: 'Practical guidance on AI use cases, data boundaries, risk controls and governance.',
    tags: ['AI Risk', 'Governance'],
  },
  {
    id: 'enablement',
    n: '03',
    zh: '企业 AI 应用培训',
    en: 'Enterprise AI Enablement',
    descZh: '结合真实业务流程，帮助团队在保留人工判断和安全边界的前提下有效使用 AI。',
    descEn: 'Help teams apply AI to real workflows while keeping security and human oversight in focus.',
    tags: ['GenAI', 'Workshops'],
  },
];
const courses = [
  {
    zh: 'AI 安全基础',
    en: 'AI Security Essentials',
    levelZh: '管理层 · 业务团队',
    levelEn: 'Leaders · Business Teams',
    descZh: '理解生成式 AI 风险、敏感信息保护和安全使用原则。',
    descEn: 'Understand generative AI risks, sensitive data and safe-use fundamentals.',
  },
  {
    zh: '企业生成式 AI 安全应用',
    en: 'Secure Generative AI at Work',
    levelZh: '企业员工 · 部门团队',
    levelEn: 'Employees · Functional Teams',
    descZh: '围绕实际工作任务建立 AI 使用流程、验证机制与责任边界。',
    descEn: 'Build safe workflows, output validation habits and clear human accountability.',
  },
  {
    zh: '网络安全与 AI 风险工作坊',
    en: 'Cybersecurity & AI Risk Workshop',
    levelZh: 'IT · 安全 · 治理团队',
    levelEn: 'IT · Security · Governance',
    descZh: '梳理技术与组织风险，形成优先事项及后续行动计划。',
    descEn: 'Map technical and organizational risks and prioritize next steps.',
  },
];
---

<Layout metadata={metadata}>
  <div class="leo-site">
    <section class="leo-hero" id="top">
      <div class="leo-wrap hero-grid">
        <div class="hero-copy">
          <p
            class="overline"
            data-aw-i18n
            data-aw-i18n-zh="CYBERSECURITY × AI SECURITY"
            data-aw-i18n-en="CYBERSECURITY × AI SECURITY"
          >
            CYBERSECURITY × AI SECURITY
          </p>
          <h1 data-aw-i18n data-aw-i18n-zh="守护 AI 时代的数字安全。" data-aw-i18n-en="Securing the Future of AI.">
            守护 AI 时代的<br />数字安全。
          </h1>
          <p
            class="hero-lead"
            data-aw-i18n
            data-aw-i18n-zh="让 AI 应用更安全，让网络安全更智能。"
            data-aw-i18n-en="Secure AI adoption. Stronger cyber resilience."
          >
            让 AI 应用更安全，让网络安全更智能。
          </p>
          <p
            class="hero-desc"
            data-aw-i18n
            data-aw-i18n-zh="LEO 聚焦网络安全与人工智能安全的融合，为企业与专业团队提供实用导向的培训、风险治理咨询及能力建设。"
            data-aw-i18n-en="LEO connects cybersecurity and AI security through practical training, risk advisory and capability-building for organizations and professional teams."
          >
            LEO 聚焦网络安全与人工智能安全的融合，为企业与专业团队提供实用导向的培训、风险治理咨询及能力建设。
          </p>
          <div class="hero-cta">
            <a
              class="leo-btn primary"
              href="#contact"
              data-aw-i18n
              data-aw-i18n-zh="了解合作方式 ↗"
              data-aw-i18n-en="Explore Collaboration ↗">了解合作方式 ↗</a
            >
            <a
              class="leo-btn ghost"
              href="#services"
              data-aw-i18n
              data-aw-i18n-zh="探索专业服务 ↓"
              data-aw-i18n-en="Explore Services ↓">探索专业服务 ↓</a
            >
          </div>
          <p
            class="hero-fine"
            data-aw-i18n
            data-aw-i18n-zh="Cybersecurity · AI Security · Training · Advisory"
            data-aw-i18n-en="Cybersecurity · AI Security · Training · Advisory"
          >
            Cybersecurity · AI Security · Training · Advisory
          </p>
        </div>
        <div class="ai-visual" role="img" aria-label="Abstract AI security network illustration">
          <div class="visual-top"><span>LEO / SECURITY INTELLIGENCE</span><span>01—03</span></div>
          <div class="visual-glow"></div><div class="ring ring-a"></div><div class="ring ring-b"></div><div
            class="ring ring-c"
          >
          </div>
          <div class="visual-cross cross-a"></div><div class="visual-cross cross-b"></div>
          <div class="core"><span>AI</span><small>SECURITY</small></div>
          <div class="node node-a">RISK <b>01</b></div><div class="node node-b">TRUST <b>02</b></div><div
            class="node node-c"
          >
            HUMAN <b>03</b>
          </div>
          <div class="visual-bottom"><span>SECURE · ASSESS · ENABLE</span><span>↗</span></div>
        </div>
      </div>
    </section>
    <div class="value-bar">
      <div class="leo-wrap">
        <span>SECURING AI. EMPOWERING PEOPLE.</span><span
          data-aw-i18n
          data-aw-i18n-zh="风险意识 / 实际应用 / 人的判断"
          data-aw-i18n-en="Risk Awareness / Practical Adoption / Human Judgment">风险意识 / 实际应用 / 人的判断</span>
      </div>
    </div>

    <section id="about" class="leo-section leo-wrap about-grid">
      <div>
        <p class="section-kicker">01 / ABOUT LEO</p><h2
          data-aw-i18n
          data-aw-i18n-zh="技术不断变化。安全与判断始终重要。"
          data-aw-i18n-en="Technology evolves. Trust and judgment remain."
        >
          技术不断变化。<br />安全与判断始终重要。
        </h2>
      </div>
      <div class="about-copy">
        <p
          data-aw-i18n
          data-aw-i18n-zh="LEO 关注网络安全、AI 安全与组织能力建设之间的连接：从理解新兴风险，到设计培训和治理路径，强调把复杂技术转化为可理解、可讨论、可执行的实践。"
          data-aw-i18n-en="LEO works at the intersection of cybersecurity, AI security and organizational learning — translating complex risks into practical guidance, training and governance conversations."
        >
          LEO 关注网络安全、AI
          安全与组织能力建设之间的连接：从理解新兴风险，到设计培训和治理路径，强调把复杂技术转化为可理解、可讨论、可执行的实践。
        </p><p
          class="about-caveat"
          data-aw-i18n
          data-aw-i18n-zh="个人履历、专业认证与项目经历将在核实后补充；本站不使用虚构背书。"
          data-aw-i18n-en="Verified biography, certifications and project experience will be added when available; no fabricated credentials."
        >
          个人履历、专业认证与项目经历将在核实后补充；本站不使用虚构背书。
        </p><a
          class="leo-text-link"
          href={getPermalink('/safeguards')}
          data-aw-i18n
          data-aw-i18n-zh="了解工作原则与边界 ↗"
          data-aw-i18n-en="Working Principles & Boundaries ↗">了解工作原则与边界 ↗</a>
      </div>
    </section>

    <section id="services" class="leo-section pale">
      <div class="leo-wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">02 / SERVICES</p><h2
              data-aw-i18n
              data-aw-i18n-zh="聚焦三项核心服务。"
              data-aw-i18n-en="Three Areas of Focus."
            >
              聚焦三项核心服务。
            </h2>
          </div><p
            data-aw-i18n
            data-aw-i18n-zh="从安全基础到 AI 治理，以实际业务需求决定服务范围。"
            data-aw-i18n-en="From cyber foundations to AI governance, scoped around real business needs."
          >
            从安全基础到 AI 治理，以实际业务需求决定服务范围。
          </p>
        </div><div class="service-grid">
          {
            services.map((s) => (
              <article class="service-card">
                <>
                  <div class="service-number">
                    {s.n} <span>↗</span>
                  </div>
                  <h3 data-aw-i18n data-aw-i18n-zh={s.zh} data-aw-i18n-en={s.en}>
                    {s.zh}
                  </h3>
                  <p data-aw-i18n data-aw-i18n-zh={s.descZh} data-aw-i18n-en={s.descEn}>
                    {s.descZh}
                  </p>
                  <div class="tag-row">
                    {s.tags.map((t) => (
                      <span>{t}</span>
                    ))}
                  </div>
                  <a
                    href={getPermalink('/services')}
                    class="leo-text-link"
                    data-aw-i18n
                    data-aw-i18n-zh="了解服务内容 ↗"
                    data-aw-i18n-en="View Service Details ↗"
                  >
                    了解服务内容 ↗
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="leo-section leo-wrap" id="training">
      <div class="section-head">
        <div>
          <p class="section-kicker">03 / TRAINING</p><h2
            data-aw-i18n
            data-aw-i18n-zh="从知识到行动的培训。"
            data-aw-i18n-en="Learning That Leads to Action."
          >
            从知识到行动的培训。
          </h2>
        </div><p
          data-aw-i18n
          data-aw-i18n-zh="培训主题示例；具体大纲、时长与交付形式按需求确定。"
          data-aw-i18n-en="Illustrative programs; syllabus, duration and delivery are tailored by agreement."
        >
          培训主题示例；具体大纲、时长与交付形式按需求确定。
        </p>
      </div><div class="course-list">
        {
          courses.map((c, i) => (
            <div class="course-item">
              <>
                <span class="course-index">0{i + 1}</span>
                <div>
                  <>
                    <p class="course-meta" data-aw-i18n data-aw-i18n-zh={c.levelZh} data-aw-i18n-en={c.levelEn}>
                      {c.levelZh}
                    </p>
                    <h3 data-aw-i18n data-aw-i18n-zh={c.zh} data-aw-i18n-en={c.en}>
                      {c.zh}
                    </h3>
                    <p data-aw-i18n data-aw-i18n-zh={c.descZh} data-aw-i18n-en={c.descEn}>
                      {c.descZh}
                    </p>
                  </>
                </div>
                <a href="#contact" aria-label="View collaboration options">
                  ↗
                </a>
              </>
            </div>
          ))
        }
      </div>
    </section>

    <section id="insights" class="leo-section pale">
      <div class="leo-wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">04 / INSIGHTS</p><h2
              data-aw-i18n
              data-aw-i18n-zh="持续研究，审慎判断。"
              data-aw-i18n-en="Research with Perspective."
            >
              持续研究，审慎判断。
            </h2>
          </div><a
            href={getBlogPermalink()}
            class="leo-text-link"
            data-aw-i18n
            data-aw-i18n-zh="浏览所有文章 ↗"
            data-aw-i18n-en="Explore All Articles ↗">浏览所有文章 ↗</a>
        </div><div class="insight-grid">
          {
            posts.map((p, i) => (
              <a href={getPermalink(p.permalink, 'post')} class="insight-card">
                <>
                  <div class="insight-cover">
                    <>
                      <span>LEO / INSIGHTS</span>
                      <strong>{['⌘', '◎', '↗'][i]}</strong>
                      <small>SECURITY × INTELLIGENCE</small>
                    </>
                  </div>
                  <div class="insight-body">
                    <>
                      <time datetime={p.publishDate.toISOString()}>{p.publishDate.toISOString().slice(0, 10)}</time>
                      <h3>{p.title}</h3>
                      <p>{p.excerpt}</p>
                      <span
                        class="leo-text-link"
                        data-aw-i18n
                        data-aw-i18n-zh="阅读全文 ↗"
                        data-aw-i18n-en="Read Article ↗"
                      >
                        阅读全文 ↗
                      </span>
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="leo-wrap contact-grid">
        <div>
          <p class="section-kicker">05 / COLLABORATION</p><h2
            data-aw-i18n
            data-aw-i18n-zh="一起探讨更安全的 AI 未来。"
            data-aw-i18n-en="Let's Shape a More Secure AI Future."
          >
            一起探讨更安全的<br />AI 未来。
          </h2><p
            data-aw-i18n
            data-aw-i18n-zh="无论是安全培训、AI 风险治理，还是跨团队能力建设，都可以从明确业务需求与安全边界开始。"
            data-aw-i18n-en="For security learning, AI risk governance or team enablement, start by clarifying your needs and boundaries."
          >
            无论是安全培训、AI 风险治理，还是跨团队能力建设，都可以从明确业务需求与安全边界开始。
          </p>
        </div><div class="contact-panel">
          <p class="panel-label" data-aw-i18n data-aw-i18n-zh="当前联系状态" data-aw-i18n-en="Current Contact Status">
            当前联系状态
          </p><h3 data-aw-i18n data-aw-i18n-zh="咨询渠道准备中" data-aw-i18n-en="Consultation Channel Coming Soon">
            咨询渠道准备中
          </h3><p
            data-aw-i18n
            data-aw-i18n-zh="本站目前不接收项目申请、联系方式、项目文件或敏感数据。正式咨询渠道启用后将在此公布。"
            data-aw-i18n-en="This website does not currently collect project requests, contact details, files or sensitive data. Official contact options will be published here when available."
          >
            本站目前不接收项目申请、联系方式、项目文件或敏感数据。正式咨询渠道启用后将在此公布。
          </p><a
            href={getPermalink('/contact')}
            class="leo-btn primary"
            data-aw-i18n
            data-aw-i18n-zh="查看联系状态 ↗"
            data-aw-i18n-en="View Contact Status ↗">查看联系状态 ↗</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script is:inline>
  (function () {
    function applyLanguage(language) {
      const lang = language === 'en' ? 'en' : 'zh';
      document.querySelectorAll('[data-aw-i18n]').forEach((element) => {
        const text = element.getAttribute('data-aw-i18n-' + lang);
        if (text !== null) element.textContent = text;
      });
      document.querySelectorAll('[data-leo-lang]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.leoLang === lang));
      });
      document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
    }
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-leo-lang]');
      if (!button) return;
      const lang = button.dataset.leoLang;
      try {
        localStorage.setItem('leo-language', lang);
      } catch {
        /* Storage may be unavailable in private browsing. */
      }
      applyLanguage(lang);
    });
    function init() {
      let lang = 'zh';
      try {
        lang = localStorage.getItem('leo-language') || 'zh';
      } catch {
        /* Storage may be unavailable in private browsing. */
      }
      applyLanguage(lang);
    }
    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:after-swap', init);
    if (document.readyState !== 'loading') init();
  })();
</script>
<style>
  .leo-site {
    font-family: Inter, 'Noto Sans SC', ui-sans-serif, system-ui, sans-serif;
    color: #14233a;
  }
  .leo-wrap {
    max-width: 1180px;
    margin: auto;
    padding-left: 28px;
    padding-right: 28px;
  }
  .leo-hero {
    background: radial-gradient(ellipse at 85% 34%, #1b3e6c 0%, transparent 46%), #0b1526;
    color: #f7fbff;
    padding: 108px 0 116px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    align-items: center;
    gap: 70px;
  }
  .overline,
  .section-kicker {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.17em;
    color: #4789eb;
  }
  .leo-hero .overline {
    color: #87b9ff;
  }
  .hero-copy h1 {
    font-size: clamp(44px, 5.2vw, 75px);
    letter-spacing: -0.055em;
    line-height: 1.17;
    margin: 20px 0 24px;
    font-weight: 750;
  }
  .hero-lead {
    font-size: clamp(19px, 2vw, 26px);
    font-weight: 600;
    color: #e2edfc;
    margin: 0 0 18px;
  }
  .hero-desc {
    max-width: 540px;
    line-height: 1.9;
    color: #a9bdd6;
    font-size: 16px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .leo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    padding: 14px 23px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .leo-btn:hover {
    transform: translateY(-2px);
  }
  .leo-btn.primary {
    background: #3979e5;
    color: white;
  }
  .leo-btn.ghost {
    color: white;
    border: 1px solid #57718d;
  }
  .hero-fine {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #8ba3c1;
    margin-top: 34px;
  }
  .ai-visual {
    position: relative;
    aspect-ratio: 1/1.02;
    overflow: hidden;
    background: radial-gradient(circle at center, #164e87 0%, #0c2240 38%, #081525 74%);
    border: 1px solid #355377;
    border-radius: 18px;
    box-shadow: 0 30px 100px #0004;
  }
  .visual-top,
  .visual-bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
    color: #89aacf;
    font-size: 10px;
    letter-spacing: 0.12em;
    z-index: 5;
  }
  .visual-top {
    top: 24px;
  }
  .visual-bottom {
    bottom: 24px;
  }
  .visual-glow {
    position: absolute;
    inset: 27%;
    border-radius: 50%;
    background: #2d91f5;
    filter: blur(75px);
    opacity: 0.4;
  }
  .ring {
    position: absolute;
    border: 1px solid #5ca8ee66;
    border-radius: 50%;
    inset: 17%;
  }
  .ring-b {
    inset: 27%;
    border-style: dashed;
    transform: rotate(28deg);
  }
  .ring-c {
    inset: 7%;
    border-color: #4779a633;
  }
  .visual-cross {
    position: absolute;
    background: #77bdf522;
  }
  .cross-a {
    height: 1px;
    width: 100%;
    top: 50%;
  }
  .cross-b {
    width: 1px;
    height: 100%;
    left: 50%;
  }
  .core {
    position: absolute;
    inset: 38%;
    background: #102c4c;
    border: 1px solid #78bdf5;
    box-shadow: 0 0 50px #3a9bec77;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .core span {
    font-size: clamp(26px, 4vw, 54px);
    font-weight: 800;
    letter-spacing: -0.06em;
    color: #e8f7ff;
  }
  .core small {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: #9cd2ff;
  }
  .node {
    position: absolute;
    padding: 9px 12px;
    border: 1px solid #5487b477;
    background: #0b2038;
    color: #c6e6ff;
    font-size: 11px;
    border-radius: 5px;
    letter-spacing: 0.1em;
  }
  .node b {
    color: #64a6ee;
    margin-left: 8px;
  }
  .node-a {
    left: 8%;
    top: 32%;
  }
  .node-b {
    right: 6%;
    top: 26%;
  }
  .node-c {
    right: 9%;
    bottom: 28%;
  }
  .value-bar {
    background: #132f51;
    color: #bfd5eb;
    padding: 18px 0;
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .value-bar .leo-wrap {
