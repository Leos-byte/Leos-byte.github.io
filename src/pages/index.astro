---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Leo 的技术札记',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Astro / GitHub Pages / Notes"
    actions={[
      { variant: 'primary', text: '阅读文章', href: getBlogPermalink(), icon: 'tabler:book-2' },
      { text: '关于作者', href: getPermalink('/about') },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '工作台与开发笔记' }}
  >
    <Fragment slot="title"> Leo 的技术札记 </Fragment>

    <Fragment slot="subtitle">
      记录 Astro、前端工程、自动化部署和日常开发经验，把踩过的坑整理成可复用的笔记。
    </Fragment>
  </Hero>

  <BlogLatestPosts
    title="最新文章"
    linkText="查看全部文章"
    count={3}
    information="围绕静态站点、内容管理、部署链路和写作工作流的实践记录。"
  />

  <Features2
    title="博客关注点"
    subtitle="偏向工程实践、可维护性和真实部署流程。"
    columns={3}
    items={[
      {
        title: 'Astro 实践',
        description: '站点结构、内容集合、MDX 和性能优化。',
        icon: 'tabler:brand-astro',
      },
      {
        title: '部署自动化',
        description: 'GitHub Pages、Actions、构建配置和发布验证。',
        icon: 'tabler:cloud-upload',
      },
      {
        title: '写作工作流',
        description: '让文章元数据、标签和 RSS 保持清晰一致。',
        icon: 'tabler:pencil',
      },
    ]}
  />
</Layout>
