---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, fetchPosts, getStaticPathsBlogList } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const posts = await fetchPosts();
const categories = [
  ...new Map(posts.filter((post) => post.category).map((post) => [post.category!.slug, post.category!])).values(),
];

const metadata = {
  title: currentPage > 1 ? `公开文章｜第 ${currentPage} 页` : '公开文章｜LeoOne',
  ignoreTitleTemplate: true,
  description: 'LeoOne 已公开发布的中文文章，标注来源、日期和适用条件；它们是研究与写作材料，不是客户案例或服务成果。',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="这里收录 LeoOne 已公开发布的中文文章。文章标明事实、假设、来源和适用条件；它们不是客户案例，也不代表服务成果。"
    >
      公开文章
    </Headline>
    {
      categories.length > 0 && (
        <p class="mb-8 -mt-4 md:-mt-10 text-center">
          按栏目浏览：
          {categories.map((category, index) => (
            <>
              {index > 0 ? ' · ' : ''}
              <a class="hover:underline" href={getPermalink(category.slug, 'category')}>
                {category.title}
              </a>
            </>
          ))}
        </p>
      )
    }
    {
      page.data.length > 0 ? (
        <>
          <BlogList posts={page.data} />
          <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} prevText="更新的文章" nextText="更早的文章" />
        </>
      ) : (
        <p class="text-lg text-muted dark:text-slate-400 text-center">
          公开文章正在整理中。本站不会用模板文章补足内容。
        </p>
      )
    }
  </section>
</Layout>
