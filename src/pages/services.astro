---
import Layout from '~/layouts/PageLayout.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'AI 转型咨询｜LeoOne',
  ignoreTitleTemplate: true,
  description: '了解 LeoOne 如何面向个人和企业梳理 AI 应用问题；制造业 AI 工作流诊断与试点准备是当前公开的重点入口。',
};

const manufacturingMaterials = [
  {
    id: 'workflow-roadmap',
    title: '制造业 AI 工作流诊断与试点路线图',
    description: '围绕真实流程梳理现状、比较候选场景，并形成首个试点的优先级、范围与准备事项。',
  },
  {
    id: 'pilot-readiness',
    title: 'AI 试点准备与治理设计',
    description: '围绕已选方向梳理责任、数据边界、人工复核、评估方式和启动前需要确认的条件。',
  },
  {
    id: 'workshop',
    title: '制造团队 AI 工作流共创工作坊',
    description: '围绕一个真实流程，记录候选场景、风险、依赖和需要进一步确认的责任事项。',
  },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl">
      <p class="font-semibold text-primary dark:text-blue-500">AI 转型咨询</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        先判断 AI 应用在哪里，再决定如何开始
      </h1>
      <p class="mt-5 text-xl text-muted dark:text-slate-300">
        LeoOne 面向个人和企业提供 AI 转型咨询。我们关注 AI
        的应用切入点、起步方式、所需能力和治理准备，以及试点和后续变化如何组织。具体项目范围以书面确认为准。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 max-w-5xl">
      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">面向个人</h2>
        <p class="mt-3 text-muted dark:text-slate-300">
          如果你正在考虑如何在职业、学习、创作或日常工作中使用
          AI，可以先把模糊问题梳理为目标、现状和需要进一步判断的事项。这里不提供个人服务目录、预约或项目申请入口。
        </p>
      </section>
      <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 md:p-8">
        <h2 class="text-2xl font-bold font-heading">面向企业</h2>
        <p class="mt-3 text-muted dark:text-slate-300">
          如果团队准备推进
          AI，可以先围绕真实业务流程判断优先场景、试点范围、责任、数据边界、人工复核和评估方式。网站不据此承诺任何行业服务的开放状态或项目可用性。
        </p>
      </section>
    </div>
  </section>

  <section
    id="manufacturing"
    class="border-y border-gray-200 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-900/30 scroll-mt-24"
  >
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
      <div class="max-w-4xl">
        <p class="font-semibold text-primary dark:text-blue-500">当前企业重点</p>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight font-heading">制造业 AI 工作流诊断与试点准备</h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-300">
          制造业是 LeoOne 当前已公开的重点场景。现有材料聚焦制造团队如何围绕真实流程，明确首个 AI
          试点的优先级、范围和必要控制点；它不是 LeoOne 的唯一业务身份，也不代表其他企业服务已经开放。
        </p>
      </div>

      <h3 class="mt-10 text-2xl font-bold font-heading">已公开的制造业材料</h3>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          manufacturingMaterials.map(({ id, title, description }) => (
            <article
              id={id}
              class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 scroll-mt-24"
            >
              <h4 class="text-xl font-bold font-heading">{title}</h4>
              <p class="mt-3 text-muted dark:text-slate-300">{description}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 max-w-4xl text-sm text-muted dark:text-slate-300">
        以上为当前公开的制造业内容。是否接受新咨询、通过何种渠道联系、何时报价或启动，均不由本页推定。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12">
    <p class="text-muted dark:text-slate-300">
      实际工作范围、责任、可用信息和交付安排均须书面确认。
      <a class="font-semibold text-primary hover:underline dark:text-blue-500" href={getPermalink('/safeguards')}>
        查看服务边界 →
      </a>
    </p>
  </section>
</Layout>
