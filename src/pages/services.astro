---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '方法与范围',
  description: 'LeoOne 如何筛选公开 AI 研究与 AI Agent 安全信息、标注证据状态，并说明当前不覆盖的范围。',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        我们如何处理公开 AI 研究与 Agent 安全信息
      </h1>
      <p class="mt-4 text-xl text-muted dark:text-slate-300">
        本页描述 LeoOne 的公开编辑方法，不是咨询、监控或安全服务承诺。
      </p>
    </div>

    <!-- 覆盖主题 -->

    <h2 class="mt-12 md:mt-16 text-3xl md:text-4xl font-bold tracking-tight font-heading">覆盖主题</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        [
          {
            title: 'AI Agent 安全',
            description: '公开披露、更新、研究与缓解信息；重点是受影响条件和行动优先级。',
          },
          {
            title: '前沿 AI 研究',
            description: '能力、世界模型、推理、Agent 等争议中的证据与可检验问题。',
          },
        ].map(({ title, description }) => (
          <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-6 md:p-8">
            <h3 class="text-xl md:text-2xl font-bold font-heading">{title}</h3>
            <p class="mt-3 text-muted dark:text-slate-400">{description}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-muted dark:text-slate-400">不承诺固定频率；每篇按实际发布日期更新。</p>

    <!-- 固定处理流程 -->

    <h2 class="mt-12 md:mt-16 text-3xl md:text-4xl font-bold tracking-tight font-heading">固定处理流程</h2>
    <ol class="mt-8 space-y-4 text-lg">
      {
        [
          '定义问题与时间窗口。',
          '采集并优先链接原始公告、论文、代码库、机构材料或直接记录。',
          '交叉检查发布日期、受影响前提、版本/配置与已知限制。',
          '用标签区分：已证实、机构/作者主张、早期研究、未决问题。',
          '发布前审校；后续发现实质错误则更正并记录日期与原因。',
        ].map((step, index) => (
          <li class="flex gap-4">
            <span class="flex-none font-bold text-2xl text-primary dark:text-blue-500">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="leading-snug">{step}</span>
          </li>
        ))
      }
    </ol>

    <!-- 单篇文章的最低内容结构 -->

    <h2 class="mt-12 md:mt-16 text-3xl md:text-4xl font-bold tracking-tight font-heading">单篇文章的最低内容结构</h2>
    <ul class="mt-8 space-y-4 text-lg">
      {
        [
          '发生了什么 / 核心问题',
          '对谁/什么环境可能相关',
          '证据状态与时间范围',
          '可考虑的下一步（不替代安全/法律意见）',
          '原始来源与更新记录',
        ].map((item) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="flex-none mt-2 h-2 w-2 rounded-full bg-primary dark:bg-blue-500" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <!-- 当前不做 -->

    <h2 class="mt-12 md:mt-16 text-3xl md:text-4xl font-bold tracking-tight font-heading">当前不做</h2>
    <p class="mt-6 text-lg text-muted dark:text-slate-400">
      与<a class="underline" href={getPermalink('/safeguards')}>安全与编辑边界</a
      >一致：不提供实时预警、系统扫描、事件处置、攻击指导、合规/法律意见，也不承诺付费或定制交付。
    </p>
  </section>

  <CallToAction
    title="继续阅读"
    actions={[
      { variant: 'primary', text: '阅读已发布洞见', href: getBlogPermalink() },
      { text: '阅读安全与边界', href: getPermalink('/safeguards') },
    ]}
  />
</Layout>
