---
import { SITE_TITLE } from "../consts";
import { withBase } from "../lib/url";

const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "文章" },
  { href: "/tags/", label: "标签" },
  { href: "/rss.xml", label: "RSS" },
];

const basePath = new URL(import.meta.env.BASE_URL, "https://example.com").pathname;
const currentPath = Astro.url.pathname.startsWith(basePath)
  ? `/${Astro.url.pathname.slice(basePath.length)}`
  : Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <a class="brand" href={withBase("/")}>{SITE_TITLE}</a>
  <nav aria-label="主导航">
    {
      navItems.map((item) => (
        <a
          class:list={{ active: isActive(item.href) }}
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
