---
import { GITHUB_URL, SITE_AUTHOR, SITE_TITLE } from "../consts";
import { withBase } from "../lib/url";
---

<footer class="site-footer">
  <p>&copy; {new Date().getFullYear()} {SITE_AUTHOR}. Built with Astro.</p>
  <div class="footer-links">
    <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
    <a href={withBase("/rss.xml")}>RSS</a>
    <a href={withBase("/")} aria-label={SITE_TITLE}>Top</a>
  </div>
</footer>
