---
import { SITE } from 'astrowind:config';
---

<footer class="leo-global-footer">
  <div class="leo-global-foot">
    <span>© {new Date().getFullYear()} {SITE?.name || 'LEO Cybersecurity & AI'}. All rights reserved.</span>
    <div class="leo-global-links">
      <a href="/about">关于 LEO</a><a href="/services">专业服务</a><a href="/training">培训课程</a><a href="/blog"
        >博客</a
      ><a href="/privacy">隐私说明</a><a href="/contact">联系咨询</a>
    </div>
  </div>
</footer>
<style>
  .leo-global-footer {
    background: #091321;
    color: #aabbd0;
    padding: 34px 0;
    font-size: 12px;
    line-height: 1.7;
  }
  .leo-global-foot {
    width: min(1120px, calc(100% - 44px));
    margin: auto;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .leo-global-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .leo-global-links a {
    color: #aabbd0;
    text-decoration: none;
  }
  .leo-global-links a:hover {
    color: #fff;
  }
</style>
