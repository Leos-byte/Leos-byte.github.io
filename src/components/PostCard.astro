---
import type { BlogPost } from "../lib/posts";
import { formatDate, getPostUrl, slugifyTag } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={["post-card", { featured }]}>
  {
    post.data.cover && (
      <a class="post-card__image" href={withBase(getPostUrl(post))} aria-label={post.data.title}>
        <img src={post.data.cover} alt="" loading={featured ? "eager" : "lazy"} />
      </a>
    )
  }
  <div class="post-card__body">
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {post.data.featured && <span>精选</span>}
    </div>
    <h2>
      <a href={withBase(getPostUrl(post))}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <div class="tag-row" aria-label="文章标签">
          {post.data.tags.map((tag) => (
            <a href={withBase(`/tags/${slugifyTag(tag)}/`)}>#{tag}</a>
          ))}
        </div>
      )
    }
  </div>
</article>
