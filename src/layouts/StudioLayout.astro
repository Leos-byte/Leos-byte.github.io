---
import '~/assets/styles/studio.css';
import Header from '~/components/StudioHeader.astro';
import Footer from '~/components/StudioFooter.astro';
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head
    ><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta
      name="theme-color"
      content="#f8f7f4"
    /><title>{title} — LEOONE</title><meta name="description" content={description} /><link
      rel="canonical"
      href={new URL(Astro.url.pathname, 'https://leoone.uk')}
    /><meta property="og:title" content={`${title} — LEOONE`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" /><link
      rel="alternate"
      type="application/rss+xml"
      title="LEOONE Journal"
      href="/rss.xml"
    /></head
  ><body
    ><a class="skip" href="#main-content">跳至主要内容</a><Header /><main id="main-content" class="wrap studio-page">
      <slot />
    </main><Footer /></body
  >
</html>
